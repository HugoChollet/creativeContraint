{
  "name": "kadex",
  "main": "expo-router/entry",
  "version": "0.5.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.1.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:ios-sim": "eas build --platform ios --profile development-simulator",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "install:apk:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "logs:android": "adb logcat -v time ReactNativeJS:I ReactNative:I Expo:I AndroidRuntime:E *:S",
    "logs:android:all": "adb logcat -v time",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "lint": "expo lint",
    "build:local": "node ./build-local.js",
    "build:local:android": "node ./build-local.js android",
    "build:local:ios": "node ./build-local.js ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@lodev09/react-native-true-sheet": "^3.7.0-beta.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.6.13",
    "@supabase/supabase-js": "^2.90.1",
    "@uiw/react-color-colorful": "^2.10.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^54.0.32",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.22",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.7.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
